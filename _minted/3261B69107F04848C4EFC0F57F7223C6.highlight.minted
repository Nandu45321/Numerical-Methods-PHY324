\begin{MintedVerbatim}[commandchars=\\\{\}]
\PYG{k+kn}{import}\PYG{+w}{ }\PYG{n+nn}{numpy}\PYG{+w}{ }\PYG{k}{as}\PYG{+w}{ }\PYG{n+nn}{np}

\PYG{c+c1}{\PYGZsh{} We have two equations we want to solve simultaneously:}
\PYG{c+c1}{\PYGZsh{} 1) x1 \PYGZhy{} x0\PYGZca{}3 = 0}
\PYG{c+c1}{\PYGZsh{} 2) x0\PYGZca{}2 + x1\PYGZca{}2 \PYGZhy{} 1 = 0}
\PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{F}\PYG{p}{(}\PYG{n}{x}\PYG{p}{):}
    \PYG{k}{return} \PYG{n}{np}\PYG{o}{.}\PYG{n}{array}\PYG{p}{([}
        \PYG{n}{x}\PYG{p}{[}\PYG{l+m+mi}{1}\PYG{p}{]} \PYG{o}{\PYGZhy{}} \PYG{n}{x}\PYG{p}{[}\PYG{l+m+mi}{0}\PYG{p}{]}\PYG{o}{**}\PYG{l+m+mi}{3}\PYG{p}{,}
        \PYG{n}{x}\PYG{p}{[}\PYG{l+m+mi}{0}\PYG{p}{]}\PYG{o}{**}\PYG{l+m+mi}{2} \PYG{o}{+} \PYG{n}{x}\PYG{p}{[}\PYG{l+m+mi}{1}\PYG{p}{]}\PYG{o}{**}\PYG{l+m+mi}{2} \PYG{o}{\PYGZhy{}} \PYG{l+m+mi}{1}
    \PYG{p}{])}

\PYG{c+c1}{\PYGZsh{} The Jacobian is a matrix of the partial derivatives of those equations}
\PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{Jacobian}\PYG{p}{(}\PYG{n}{x}\PYG{p}{):}
    \PYG{k}{return} \PYG{n}{np}\PYG{o}{.}\PYG{n}{array}\PYG{p}{([}
        \PYG{p}{[}\PYG{o}{\PYGZhy{}}\PYG{l+m+mi}{3} \PYG{o}{*} \PYG{n}{x}\PYG{p}{[}\PYG{l+m+mi}{0}\PYG{p}{]}\PYG{o}{**}\PYG{l+m+mi}{2}\PYG{p}{,}  \PYG{l+m+mi}{1}\PYG{p}{],}
        \PYG{p}{[} \PYG{l+m+mi}{2} \PYG{o}{*} \PYG{n}{x}\PYG{p}{[}\PYG{l+m+mi}{0}\PYG{p}{],}     \PYG{l+m+mi}{2} \PYG{o}{*} \PYG{n}{x}\PYG{p}{[}\PYG{l+m+mi}{1}\PYG{p}{]]}
    \PYG{p}{])}

\PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{newton\PYGZus{}system}\PYG{p}{(}\PYG{n}{F}\PYG{p}{,} \PYG{n}{Jacobian}\PYG{p}{,} \PYG{n}{initial\PYGZus{}guess}\PYG{p}{,} \PYG{n}{tol}\PYG{o}{=}\PYG{l+m+mf}{1e\PYGZhy{}6}\PYG{p}{,} \PYG{n}{max\PYGZus{}iter}\PYG{o}{=}\PYG{l+m+mi}{100}\PYG{p}{):}
    \PYG{n}{x} \PYG{o}{=} \PYG{n}{np}\PYG{o}{.}\PYG{n}{array}\PYG{p}{(}\PYG{n}{initial\PYGZus{}guess}\PYG{p}{,} \PYG{n}{dtype}\PYG{o}{=}\PYG{n+nb}{float}\PYG{p}{)}

    \PYG{k}{for} \PYG{n}{i} \PYG{o+ow}{in} \PYG{n+nb}{range}\PYG{p}{(}\PYG{n}{max\PYGZus{}iter}\PYG{p}{):}
        \PYG{c+c1}{\PYGZsh{} We need to solve: Jacobian * step = \PYGZhy{}F(x)}
        \PYG{n}{J} \PYG{o}{=} \PYG{n}{Jacobian}\PYG{p}{(}\PYG{n}{x}\PYG{p}{)}
        \PYG{n}{fx} \PYG{o}{=} \PYG{n}{F}\PYG{p}{(}\PYG{n}{x}\PYG{p}{)}

        \PYG{c+c1}{\PYGZsh{} We use np.linalg.solve (which does LU/Gauss under the hood) to find the step}
        \PYG{n}{step} \PYG{o}{=} \PYG{n}{np}\PYG{o}{.}\PYG{n}{linalg}\PYG{o}{.}\PYG{n}{solve}\PYG{p}{(}\PYG{n}{J}\PYG{p}{,} \PYG{o}{\PYGZhy{}}\PYG{n}{fx}\PYG{p}{)}

        \PYG{c+c1}{\PYGZsh{} Take the step}
        \PYG{n}{x} \PYG{o}{=} \PYG{n}{x} \PYG{o}{+} \PYG{n}{step}

        \PYG{c+c1}{\PYGZsh{} If the step was tiny, we have converged!}
        \PYG{k}{if} \PYG{n}{np}\PYG{o}{.}\PYG{n}{linalg}\PYG{o}{.}\PYG{n}{norm}\PYG{p}{(}\PYG{n}{step}\PYG{p}{)} \PYG{o}{\PYGZlt{}} \PYG{n}{tol}\PYG{p}{:}
            \PYG{n+nb}{print}\PYG{p}{(}\PYG{l+s+sa}{f}\PYG{l+s+s2}{\PYGZdq{}Converged in }\PYG{l+s+si}{\PYGZob{}}\PYG{n}{i}\PYG{o}{+}\PYG{l+m+mi}{1}\PYG{l+s+si}{\PYGZcb{}}\PYG{l+s+s2}{ iterations.\PYGZdq{}}\PYG{p}{)}
            \PYG{k}{return} \PYG{n}{x}

    \PYG{k}{return} \PYG{n}{x}

\PYG{c+c1}{\PYGZsh{} Example usage}
\PYG{n}{initial\PYGZus{}guess} \PYG{o}{=} \PYG{p}{[}\PYG{l+m+mf}{1.0}\PYG{p}{,} \PYG{l+m+mf}{2.0}\PYG{p}{]}
\PYG{n}{solution} \PYG{o}{=} \PYG{n}{newton\PYGZus{}system}\PYG{p}{(}\PYG{n}{F}\PYG{p}{,} \PYG{n}{Jacobian}\PYG{p}{,} \PYG{n}{initial\PYGZus{}guess}\PYG{p}{)}
\PYG{n+nb}{print}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}Solution:\PYGZdq{}}\PYG{p}{,} \PYG{n}{solution}\PYG{p}{)}
\end{MintedVerbatim}
