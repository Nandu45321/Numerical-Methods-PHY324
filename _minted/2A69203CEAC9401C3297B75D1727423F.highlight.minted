\begin{MintedVerbatim}[commandchars=\\\{\}]
\PYG{k+kn}{import}\PYG{+w}{ }\PYG{n+nn}{numpy}\PYG{+w}{ }\PYG{k}{as}\PYG{+w}{ }\PYG{n+nn}{np}

\PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{f}\PYG{p}{(}\PYG{n}{x}\PYG{p}{):}
    \PYG{k}{return} \PYG{n}{x}\PYG{o}{**}\PYG{l+m+mi}{2}

\PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{midpoint\PYGZus{}single}\PYG{p}{(}\PYG{n}{f}\PYG{p}{,} \PYG{n}{a}\PYG{p}{,} \PYG{n}{b}\PYG{p}{):}
    \PYG{n}{midpoint} \PYG{o}{=} \PYG{p}{(}\PYG{n}{a} \PYG{o}{+} \PYG{n}{b}\PYG{p}{)} \PYG{o}{/} \PYG{l+m+mi}{2}
    \PYG{n}{h} \PYG{o}{=} \PYG{n}{b} \PYG{o}{\PYGZhy{}} \PYG{n}{a}
    \PYG{n}{area} \PYG{o}{=} \PYG{n}{h} \PYG{o}{*} \PYG{n}{f}\PYG{p}{(}\PYG{n}{midpoint}\PYG{p}{)}
    \PYG{k}{return} \PYG{n}{area}

\PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{midpoint\PYGZus{}composite}\PYG{p}{(}\PYG{n}{f}\PYG{p}{,} \PYG{n}{a}\PYG{p}{,} \PYG{n}{b}\PYG{p}{,} \PYG{n}{num\PYGZus{}panels}\PYG{p}{):}
    \PYG{n}{h} \PYG{o}{=} \PYG{p}{(}\PYG{n}{b} \PYG{o}{\PYGZhy{}} \PYG{n}{a}\PYG{p}{)} \PYG{o}{/} \PYG{n}{num\PYGZus{}panels}

    \PYG{c+c1}{\PYGZsh{} Get the exact midpoints of every single panel}
    \PYG{n}{midpoints} \PYG{o}{=} \PYG{n}{np}\PYG{o}{.}\PYG{n}{linspace}\PYG{p}{(}\PYG{n}{a} \PYG{o}{+} \PYG{n}{h}\PYG{o}{/}\PYG{l+m+mi}{2}\PYG{p}{,} \PYG{n}{b} \PYG{o}{\PYGZhy{}} \PYG{n}{h}\PYG{o}{/}\PYG{l+m+mi}{2}\PYG{p}{,} \PYG{n}{num\PYGZus{}panels}\PYG{p}{)}

    \PYG{c+c1}{\PYGZsh{} We just sum the height of all the rectangles and multiply by width}
    \PYG{n}{area} \PYG{o}{=} \PYG{n}{h} \PYG{o}{*} \PYG{n}{np}\PYG{o}{.}\PYG{n}{sum}\PYG{p}{(}\PYG{n}{f}\PYG{p}{(}\PYG{n}{midpoints}\PYG{p}{))}
    \PYG{k}{return} \PYG{n}{area}

\PYG{c+c1}{\PYGZsh{} Example usage}
\PYG{n+nb}{print}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}Single Midpoint Area:\PYGZdq{}}\PYG{p}{,} \PYG{n}{midpoint\PYGZus{}single}\PYG{p}{(}\PYG{n}{f}\PYG{p}{,} \PYG{l+m+mi}{0}\PYG{p}{,} \PYG{l+m+mi}{1}\PYG{p}{))}
\PYG{n+nb}{print}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}Composite Midpoint Area (100 panels):\PYGZdq{}}\PYG{p}{,} \PYG{n}{midpoint\PYGZus{}composite}\PYG{p}{(}\PYG{n}{f}\PYG{p}{,} \PYG{l+m+mi}{0}\PYG{p}{,} \PYG{l+m+mi}{1}\PYG{p}{,} \PYG{l+m+mi}{100}\PYG{p}{))}
\end{MintedVerbatim}
