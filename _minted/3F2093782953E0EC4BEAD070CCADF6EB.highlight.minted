\PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{compute\PYGZus{}natural\PYGZus{}cubic\PYGZus{}spline}\PYG{p}{(}\PYG{n}{x}\PYG{p}{,} \PYG{n}{y}\PYG{p}{):}
