\PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{evaluate\PYGZus{}spline}\PYG{p}{(}\PYG{n}{x\PYGZus{}query}\PYG{p}{,} \PYG{n}{x\PYGZus{}data}\PYG{p}{,} \PYG{n}{a}\PYG{p}{,} \PYG{n}{b}\PYG{p}{,} \PYG{n}{c}\PYG{p}{,} \PYG{n}{d}\PYG{p}{):}
\PYG{+w}{    }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}Evaluates the spline at given query coordinates.\PYGZdq{}\PYGZdq{}\PYGZdq{}}
    \PYG{n}{y\PYGZus{}query} \PYG{o}{=} \PYG{p}{[]}
