\PYG{l+s+sd}{    Computes coefficients for the piecewise cubic polynomials:}
\PYG{l+s+sd}{    S\PYGZus{}i(x) = a\PYGZus{}i + b\PYGZus{}i*(x \PYGZhy{} x\PYGZus{}i) + c\PYGZus{}i*(x \PYGZhy{} x\PYGZus{}i)\PYGZca{}2 + d\PYGZus{}i*(x \PYGZhy{} x\PYGZus{}i)\PYGZca{}3}
\PYG{l+s+sd}{    \PYGZdq{}\PYGZdq{}\PYGZdq{}}
    \PYG{n}{x} \PYG{o}{=} \PYG{n}{np}\PYG{o}{.}\PYG{n}{array}\PYG{p}{(}\PYG{n}{x}\PYG{p}{,} \PYG{n}{dtype}\PYG{o}{=}\PYG{n+nb}{float}\PYG{p}{)}
    \PYG{n}{y} \PYG{o}{=} \PYG{n}{np}\PYG{o}{.}\PYG{n}{array}\PYG{p}{(}\PYG{n}{y}\PYG{p}{,} \PYG{n}{dtype}\PYG{o}{=}\PYG{n+nb}{float}\PYG{p}{)}
    \PYG{n}{n} \PYG{o}{=} \PYG{n+nb}{len}\PYG{p}{(}\PYG{n}{x}\PYG{p}{)}

    \PYG{c+c1}{\PYGZsh{} 1. Widths of the intervals}
